{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Manifold Companion on the CAIL stack: mounted by CAIL Doorway at
  // https://tools.ailab.gc.cuny.edu/manifold-companion/ (person-funded: the
  // signed-in person's own Gateway budget pays for model calls).
  "name": "cail-manifold-companion",
  "account_id": "452c33847cf5cb1e46f391fca32fd1b5",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-25",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal", "request_signal_passthrough"],
  // Reached only through Doorway's service binding; no public hostname.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // The built React SPA, forked for this stack into worker/client (the legacy
  // client/ keeps serving the Express app on main). `npm run build:client`.
  // The Worker runs first so every request is gated.
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "services": [{ "binding": "GATEWAY", "service": "cail-model-api" }],
  // PLACEHOLDER IDs: create with `wrangler d1 create cail-manifold-companion`
  // and `wrangler r2 bucket create cail-manifold-companion-files`, then paste the
  // D1 id below. Apply schema with `wrangler d1 migrations apply DB --remote`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cail-manifold-companion",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "cail-manifold-companion-files" }],
  // Daily retention sweep (warn, then delete projects 180 days after last edit), 06:17 UTC.
  "triggers": { "crons": ["17 6 * * *"] },
  "exports": { "ManifoldCompanionReadiness": { "type": "worker" } },
  // CAIL_IDENTITY_JWKS is a Worker secret (Doorway's public JWKS), not a var.
  "vars": {
    "CAIL_API_BASE": "https://tools.ailab.gc.cuny.edu",
    "CAIL_IDENTITY_ISSUER": "https://tools.ailab.gc.cuny.edu/cail-sso",
    "CAIL_CANONICAL_ORIGIN": "https://tools.ailab.gc.cuny.edu",
    "CAIL_LOG_ENV": "production",
    "STORAGE_QUOTA_BYTES": "524288000",
    "MAX_FILE_BYTES": "10485760",
    "MAX_PDF_BYTES": "26214400",
    "MAX_PROJECT_PAGES": "300",
    "RETENTION_DAYS": "180",
    "RETENTION_WARN_DAYS": "30",
    // Model policy (src/models.ts; same values are built in as the fallback).
    // Evidence: docs/model-policy.md, live evaluation through the real Gateway on
    // 2026-11-10 (82 calls, precalculus textbook). Comma-separated ids; `*` = prefix.
    // A listed model the catalog no longer has is skipped (next one, then catalog order).
    // Standard OCR and page->HTML: DeepSeek Flash 100% at ~5-6 s/page.
    "MODEL_ORDER_VISION": "deepseek-v4.1-flash-1017,mistral-large-3-675b-instruct,qwen3.8-27b,gemma-4-26b-a4b-it",
    // Math/tables: Magistral Small 6/6 pages, ~11 s median, cheapest that passed; DeepSeek 5/6; Qwen 3.8 5/6 (~63 s).
    "MODEL_ORDER_MATH": "magistral-small-2509,deepseek-v4.1-flash-1017,qwen3.8-27b",
    "MATH_MODELS_OFFERED": "magistral-small-2509,deepseek-v4.1-flash-1017,qwen3.8-27b",
    "MODEL_ORDER_TEXT": "deepseek-v4.1-flash-1017,gpt-oss-120b,mistral-large-3-675b-instruct",
    // Owner: Kimi is overkill (never offered by default); Gemma not for maths (1/6, 4 deadline hits).
    "MODELS_HIDDEN": "kimi-*",
    "MATH_MODELS_HIDDEN": "gemma-*,kimi-*",
    // DeepSeek reasoned through the whole 14,000-token budget on the tables page with thinking on.
    "MATH_THINKING_OFF": "deepseek-v4.1-flash-1017"
  }
}
