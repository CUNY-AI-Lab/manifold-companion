><td>2</td><td>8</td></tr>\n                  <tr><td>3</td><td>27</td></tr>\n                </tbody>\n              </table>\n            </td>\n          </tr>\n          <tr>\n            <td></td>\n            <td>\n              <p>iv.</p>\n              <table>\n                <thead>\n                  <tr><th>In</th><th>Out</th></tr>\n                </thead>\n                <tbody>\n                  <tr><td>-2</td><td>4</td></tr>\n                  <tr><td>-1</td><td>1</td></tr>\n                  <tr><td>0</td><td>0</td></tr>\n                  <tr><td>1</td><td>1</td></tr>\n                  <tr><td>2</td><td>4</td></tr>\n                  <tr><td>3</td><td>9</td></tr>\n                </tbody>\n              </table>\n            </td>\n            <td>\n              <p>v.</p>\n              <table>\n                <thead>\n                  <tr><th>In</th><th>Out</th></tr>\n                </thead>\n                <tbody>\n                  <tr><td>-2</td><td>—</td></tr>\n                  <tr><td>-1</td><td>—</td></tr>\n                  <tr><td>0</td><td>0</td></tr>\n                  <tr><td>1</td><td>1</td></tr>\n                  <tr><td>4</td><td>2</td></tr>\n                  <tr><td>9</td><td>3</td></tr>\n                </tbody>\n              </table>\n            </td>\n            <td>\n              <p>vi.</p>\n              <table>\n                <thead>\n                  <tr><th>In</th><th>Out</th></tr>\n                </thead>\n                <tbody>\n                  <tr><td>-2</td><td>2</td></tr>\n                  <tr><td>-1</td><td>1</td></tr>\n                  <tr><td>0</td><td>0</td></tr>\n                  <tr><td>1</td><td>1</td></tr>\n                  <tr><td>2</td><td>2</td></tr>\n                  <tr><td>3</td><td>3</td></tr>\n                </tbody>\n              </table>\n            </td>\n          </tr>\n        </tbody>\n      </table>\n    </li>\n    <li>\n      <p>Match each equation with its table</p