{
  "name": "manifold-companion-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:client": "npm --prefix client ci && npm --prefix client run build",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "check:logging": "bash scripts/check-logging.sh",
    "test:client": "npm --prefix client test",
    "test:e2e": "npm --prefix client run e2e",
    "eval:dry-run": "node scripts/live-eval.mjs --dry-run",
    "eval:selftest": "node scripts/live-eval-selftest.mjs"
  },
  "dependencies": {
    "@cuny-ai-lab/cail-client": "6.3.0",
    "@cuny-ai-lab/cail-identity": "5.2.6",
    "@cuny-ai-lab/cail-log": "0.6.4",
    "fflate": "0.8.2",
    "hono": "4.13.17",
    "temml": "0.13.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.1",
    "@cloudflare/workers-types": "5.20261110.1",
    "parse5": "7.3.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.159.0"
  }
}
